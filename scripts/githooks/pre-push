#!/bin/bash
# musecode-base managed hook (pre-push): 文档-only 快速通道，否则 smoke + verify。
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)" || exit 2
cd "$ROOT" || exit 2
# 任一 ref 含非文档改动（或区间不可读）即走全门禁；全部 ref 纯文档才快速通道
docs_only=1
saw_ref=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then continue; fi
  saw_ref=1
  if [ "${_remote_sha:-}" = "0000000000000000000000000000000000000000" ] || [ -z "${_remote_sha:-}" ]; then
    range="$local_sha"
  else
    range="$_remote_sha..$local_sha"
  fi
  names="$(git diff --name-only "$range" 2>/dev/null)" || { docs_only=0; break; }
  if printf '%s' "$names" | grep -qE '.' && printf '%s' "$names" | grep -qvE '\.(md|txt)$|^docs/'; then
    docs_only=0; break
  fi
done
if [ "$saw_ref" -eq 1 ] && [ "$docs_only" -eq 1 ]; then
  echo "pre-push: 文档-only，跳过 verify（smoke 仍跑）"
  bash scripts/smoke.sh || exit 2
  exit 0
fi
bash scripts/smoke.sh || exit 2
bash scripts/verify.sh || exit 2
