#!/bin/bash
# musecode-base managed hook (pre-commit): smoke + staged-check + staged fitness.
# 本文件版本化存放于 scripts/githooks/，由 install-githooks.sh 经 core.hooksPath 指向。
# 禁止 --no-verify 跳过（AGENTS.md §5）。
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)" || exit 2
cd "$ROOT" || exit 2
bash scripts/smoke.sh || exit 2
bash scripts/staged-check.sh || exit 2
STAGED="$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' ',' | sed 's/,$//')"
if [ -n "$STAGED" ]; then
  # 检查对象是 index（将提交内容），不是工作树：部分暂存时工作树已改也不漏检
  bash scripts/fitness.sh --staged --paths "$STAGED" || exit 2
fi
